#!/usr/bin/env python3
"""locai — drive the local Ollama fleet to build the geotech 3D worlds.

gen   -> qwen2.5-coder (dadbox) produces a unified diff for a feature request
render-> one-shot headless chrome screenshot of a world (auto-start job 1)
crit  -> moondream (dadbox) + gemma3 (LAN boxes) look at the render and PASS/FAIL it
loop  -> gen -> render -> crit -> feed critique back -> repeat up to N iters
fleet -> list every Ollama box and its models

Server: worlds are served from the directory containing the html at :8099
(root = that dir, so /lib/* resolves). Auto-starts if not already up.
"""
import argparse, base64, json, os, re, shutil, subprocess, sys, time, urllib.request

HOSTS = [
    ("dadbox", "127.0.0.1", 11434),
    ("box197", "192.168.12.197", 11434),
    ("box205", "192.168.12.205", 11434),
    ("box168", "192.168.12.168", 11434),
    ("box169", "192.168.12.169", 11434),
    ("linuxbox", "100.113.191.120", 11434),
    ("vegas-linux-farm", "100.79.121.53", 11434),
]
CODE_HOST, CODE_MODEL = "dadbox", "qwen2.5-coder:14b"
GEN_DIR = os.path.join(os.path.dirname(os.path.abspath(__file__)), "locai-gen")
SERVER_PORT = 8099
CHROME = "google-chrome"
SHOT_DIR = os.path.join(GEN_DIR, "shots")

CONVENTIONS = (
    "Vanilla Three.js r155 (three.min.js), NO GLTFLoader, NO build step, single html file. "
    "Libs: /lib/three.min.js + /lib/OrbitControls.js + /lib/simplex-noise.js. "
    "All geometry procedural (Box/Cylinder/Sphere/DodecahedronGeometry, BufferGeometry heightmaps). "
    "Helpers: mq()/mat() for machines, hash() seeded PRNG, toast() for messages. "
    "Dark theme #0b1016, teal accent #4fd0d8, monospace HUD. "
    "Cross-port every improvement to the other 3 worlds."
)

def api(host, port, path, body=None, timeout=600):
    url = f"http://{host}:{port}/api/{path}"
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(url, data=data, headers={"Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            return json.load(r)
    except Exception as e:
        raise RuntimeError(f"{host}: {type(e).__name__}: {e}")

def pick_vision(host, port):
    try:
        tags = api(host, port, "tags", timeout=8).get("models", [])
    except Exception:
        return None
    for t in tags:
        n = t["name"]
        if "gemma" in n or "llava" in n or "moondream" in n or "vl" in n:
            return n
    return None

def cmd_fleet(args):
    for name, host, port in HOSTS:
        try:
            tags = api(host, port, "tags", timeout=8).get("models", [])
            ms = ", ".join(t["name"] for t in tags) or "(none)"
            print(f"{name:8} {host:16} OK  {ms}")
        except Exception as e:
            print(f"{name:8} {host:16} DOWN {e}")

def cmd_render(args):
    world = args.world
    if not os.path.exists(world):
        sys.exit(f"no such file: {world}")
    wdir, base = os.path.dirname(os.path.abspath(world)), os.path.basename(world)
    url = f"http://127.0.0.1:{SERVER_PORT}/{base}"
    if args.autostart or "grade" in base:
        url += "?autostart=1"
    ensure_server(wdir)
    os.makedirs(SHOT_DIR, exist_ok=True)
    out = args.out or os.path.join(SHOT_DIR, base.replace(".html", ".png"))
    cmd = [CHROME, "--headless=new", f"--screenshot={out}",
           f"--window-size={args.size}", "--hide-scrollbars",
           f"--virtual-time-budget={args.budget}",
           "--enable-unsafe-swiftshader", "--force-device-scale-factor=1", url]
    print(" ".join(cmd))
    r = subprocess.run(cmd, capture_output=True, text=True, timeout=120)
    if not os.path.exists(out) or os.path.getsize(out) < 1000:
        print("render FAILED:", r.stderr[-800:] or r.stdout[-800:]); sys.exit(1)
    print(f"shot -> {out} ({os.path.getsize(out)//1024}KB)")
    print("img:", image_stats(out))

def ensure_server(wdir):
    try:
        urllib.request.urlopen(f"http://127.0.0.1:{SERVER_PORT}/", timeout=2)
        return
    except Exception:
        pass
    log = open(os.path.join(GEN_DIR, "http.log"), "w")
    p = subprocess.Popen(["setsid", sys.executable, "-m", "http.server", str(SERVER_PORT),
                          "--bind", "127.0.0.1", "--directory", wdir],
                         stdout=log, stderr=log, stdin=subprocess.DEVNULL,
                         start_new_session=True)
    for _ in range(50):
        try:
            urllib.request.urlopen(f"http://127.0.0.1:{SERVER_PORT}/", timeout=1)
            return
        except Exception:
            time.sleep(0.2)
    sys.exit("could not start http.server on 8099")

def image_stats(path):
    try:
        from PIL import Image
        im = Image.open(path).convert("RGB")
        px = list(im.getdata())
        n = len(px)
        avg = tuple(round(sum(c[i] for c in px) / n) for i in range(3))
        std = tuple(round((sum((c[i]-avg[i])**2 for c in px)/n)**0.5) for i in range(3))
        return f"avg RGB {avg} stddev {std} {im.size[0]}x{im.size[1]}"
    except Exception as e:
        return f"(PIL unavailable: {e})"

QA_PROMPT = (
    "You are visual QA for a 3D construction game render. Reply starting with exactly "
    "'PASS' or 'FAIL', then one short line of reasons. Check: (1) is the image entirely "
    "black or blank? (2) is there a sky/background? (3) is terrain or 3D equipment visible? "
    "(4) any missing textures, overlapping UI, black meshes, or cut-off text?"
)

def cmd_crit(args):
    path = args.shot
    if not os.path.exists(path):
        sys.exit(f"no such screenshot: {path}")
    b64 = base64.b64encode(open(path, "rb").read()).decode()
    targets = []
    for name, host, port in HOSTS:
        model = pick_vision(host, port)
        if model:
            targets.append((name, host, port, model))
    if not targets:
        sys.exit("no vision model found on any host")
    print("img:", image_stats(path))
    for name, host, port, model in targets:
        try:
            t0 = time.time()
            r = api(host, port, "generate",
                    {"model": model, "prompt": QA_PROMPT, "images": [b64],
                     "stream": False, "options": {"temperature": 0.1}}, timeout=300)
            txt = (r.get("response") or "").strip()
            verdict = "PASS" if txt.upper().startswith("PASS") else "FAIL"
            print(f"{name} ({model}): {verdict}  [{time.time()-t0:.0f}s]")
            print("   " + txt.replace("\n", "\n   "))
        except Exception as e:
            print(f"{name}: ERROR {e}")

def parse_diff(resp):
    txt = re.sub(r"```[a-zA-Z]*", "", resp)
    lines = txt.splitlines()
    body, capture = [], False
    for ln in lines:
        if ln.startswith("diff --git") or ln.startswith("--- a/") or ln.startswith("+++ b/") or ln.startswith("@@"):
            capture = True
        if capture:
            body.append(ln)
    d = "\n".join(body)
    if "@@" not in d or "+++ b/" not in d:
        return None
    return d + "\n"

def excerpt(world, keywords, pad=15, cap=14000):
    lines = open(world).read().splitlines()
    hits = []
    for i, ln in enumerate(lines):
        for kw in keywords:
            if kw in ln:
                hits.append(i)
                break
    if not hits:
        return None
    ranges = []
    for i in hits:
        s, e = max(0, i - pad), min(len(lines), i + pad + 1)
        if ranges and s <= ranges[-1][1]:
            ranges[-1][1] = e
        else:
            ranges.append([s, e])
    out = []
    total = 0
    for s, e in ranges:
        block = f"--- lines {s+1}-{e} ---\n" + "\n".join(
            f"{j+1}: {lines[j]}" for j in range(s, e))
        if total + len(block) > cap:
            break
        out.append(block + "\n...")
        total += len(block)
    return "\n".join(out)

def cmd_gen(args):
    job = args.id or time.strftime("%Y%m%d-%H%M%S")
    jdir = os.path.join(GEN_DIR, job)
    os.makedirs(jdir, exist_ok=True)
    world = args.world
    wdir, base = os.path.dirname(os.path.abspath(world)), os.path.basename(world)
    src = open(world).read()
    if args.kw:
        kws = [k.strip() for k in args.kw.split(",")]
        body = excerpt(world, kws)
        num_ctx, to, mode = 4096, 600, "snippet"
        if body is None:
            sys.exit(f"no lines matched keywords: {kws}")
        prompt = (f"CONVENTIONS: {CONVENTIONS}\n\n"
                  f"TASK (be surgical, minimal changes): {args.request}\n\n"
                  f"EXCERPT of {base} (line-numbered regions containing {kws}); the full file is "
                  f"{len(src)} chars and you do NOT see it all.\n"
                  f"Reply with ONLY the exact new or replacement JavaScript for the affected "
                  f"functions/regions as ```javascript blocks, preceded by one line stating where it "
                  f"goes (e.g. 'INSERT after syncRocks' or 'REPLACE the toast() call at line N'). "
                  f"No prose beyond the location hint, no full-file output.\n\n{body}")
    else:
        num_ctx, to, mode = 32768, 1200, "fullfile"
        prompt = (f"CONVENTIONS: {CONVENTIONS}\n\n"
                  f"TASK (be surgical, minimal changes): {args.request}\n\n"
                  f"FILE {base} ({len(src)} chars) below.\n"
                  f"Reply with ONLY a unified diff using --- a/{base} / +++ b/{base} prefixes "
                  f"so `patch -p1` applies it. No prose, no code fences.\n\n{src}")
    open(os.path.join(jdir, "request.txt"), "w").write(args.request)
    print(f"gen[{job}] -> {CODE_MODEL} ({mode}, ctx={num_ctx}) ...")
    t0 = time.time()
    r = api("127.0.0.1", 11434, "generate",
            {"model": CODE_MODEL, "prompt": prompt, "stream": False,
             "options": {"num_ctx": num_ctx, "temperature": 0.2}}, timeout=to)
    resp = (r.get("response") or "")
    open(os.path.join(jdir, "response.txt"), "w").write(resp)
    print(f"  model done in {time.time()-t0:.0f}s, {len(resp)} chars")
    if mode == "snippet":
        print(f"  snippet saved to locai-gen/{job}/response.txt — apply manually")
        return job, resp
    diff = parse_diff(resp)
    if not diff:
        print("  NO parseable diff in response — see locai-gen/%s/response.txt" % job)
        sys.exit(1)
    open(os.path.join(jdir, "patch.diff"), "w").write(diff)
    if args.apply:
        bak = os.path.join(jdir, base + ".bak")
        shutil.copy2(world, bak)
        r = subprocess.run(["patch", "-d", wdir, "-p1", "--fuzz=3", "--forward", "--batch"],
                           input=diff, capture_output=True, text=True, timeout=60)
        open(os.path.join(jdir, "apply.log"), "w").write(r.stdout + r.stderr)
        if r.returncode != 0:
            print("  APPLY FAILED (backup kept): %s" % bak)
            print("  " + (r.stderr or r.stdout).strip().replace("\n", "\n  "))
            sys.exit(1)
        print(f"  applied -> {world} (backup: {bak})")
    else:
        print(f"  diff saved to locai-gen/{job}/patch.diff — rerun with --apply to use it")
    return job, diff

def cmd_loop(args):
    for it in range(1, args.max_iters + 1):
        print(f"\n=== iteration {it}/{args.max_iters} ===")
        req = args.request + ("" if it == 1 else
              f"\n\n[REVISION from visual QA — fix ALL of these: {args.feedback}]")
        args.request, args.id, args.apply = req, None, True
        args.kw = args.kw or "buildRockPool,syncRocks,rockGrp,ROCK_TYPES,toast,refreshMesh"
        args.world = args.world
        try:
            cmd_gen(args)
        except SystemExit as e:
            if e.code:
                print("gen/apply failed — stopping loop")
                return
        shot = args.shot
        if not shot:
            shot = os.path.join(SHOT_DIR, os.path.basename(args.world).replace(".html", ".png"))
            args.out, args.autostart, args.size, args.budget = shot, True, "1600,1000", 6000
            try:
                cmd_render(args)
            except SystemExit as e:
                print("render failed — stopping loop"); return
        fails, feedback = [], ""
        for name, host, port in HOSTS:
            model = pick_vision(host, port)
            if not model: continue
            b64 = base64.b64encode(open(shot, "rb").read()).decode()
            try:
                r = api(host, port, "generate",
                        {"model": model, "prompt": QA_PROMPT, "images": [b64],
                         "stream": False, "options": {"temperature": 0.1}}, timeout=300)
                txt = (r.get("response") or "").strip()
                verdict = "PASS" if txt.upper().startswith("PASS") else "FAIL"
                print(f"  crit {name}: {verdict} — {txt[:120]}")
                if verdict == "FAIL":
                    fails.append(name); feedback += f"[{name}: {txt[:200]}] "
            except Exception as e:
                print(f"  crit {name}: ERROR {e}")
        if not fails:
            print("\nALL VISION CHECKS PASS — loop complete")
            print(f"shot: {shot}")
            return
        args.feedback = feedback or "visual issues detected but no specific feedback"
        print(f"\nretry with feedback from: {', '.join(fails)}")

def main():
    ap = argparse.ArgumentParser(prog="locai", description="local Ollama fleet build loop")
    sub = ap.add_subparsers(dest="cmd", required=True)
    sub.add_parser("fleet", help="list Ollama boxes + models").set_defaults(fn=cmd_fleet)
    pr = sub.add_parser("render", help="headless screenshot of a world")
    pr.add_argument("world"); pr.add_argument("--out"); pr.add_argument("--autostart", action="store_true")
    pr.add_argument("--size", default="1600,1000"); pr.add_argument("--budget", type=int, default=6000)
    pr.set_defaults(fn=cmd_render)
    pc = sub.add_parser("crit", help="vision QA on a screenshot (all fleet)")
    pc.add_argument("shot"); pc.set_defaults(fn=cmd_crit)
    pg = sub.add_parser("gen", help="qwen2.5-coder diff for a feature")
    pg.add_argument("request"); pg.add_argument("--world", required=True)
    pg.add_argument("--id"); pg.add_argument("--apply", action="store_true")
    pg.add_argument("--kw", help="comma-separated keywords for excerpt mode (fast, snippet output)")
    pg.set_defaults(fn=cmd_gen)
    pl = sub.add_parser("loop", help="gen->render->crit until PASS")
    pl.add_argument("request"); pl.add_argument("--world", required=True)
    pl.add_argument("--max-iters", type=int, default=3)
    pl.add_argument("--kw", help="comma-separated keywords for excerpt gen mode")
    pl.set_defaults(fn=cmd_loop)
    a = ap.parse_args()
    a.feedback = ""
    a.shot = getattr(a, "shot", None)
    a.kw = getattr(a, "kw", None)
    a.fn(a)

if __name__ == "__main__":
    main()
